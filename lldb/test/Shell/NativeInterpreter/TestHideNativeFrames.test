# Tests that target.native-interpreter-hide-native-frames=true suppresses
# native C frames so only synthetic Python frames appear in bt.

# REQUIRES: python
# UNSUPPORTED: system-windows

# RUN: env PYTHONPATH=%ibid_lib_dir %lldb -b \
# RUN:   -o "settings set target.enable-native-interpreter true" \
# RUN:   -o "settings set target.native-interpreter-hide-native-frames true" \
# RUN:   -o "file %python" \
# RUN:   -o "settings set target.run-args %S/Inputs/ibid_test.py" \
# RUN:   -o "breakpoint set --file ibid_test.py --line 5" \
# RUN:   -o "run" \
# RUN:   -o "bt" \
# RUN:   -o "quit" \
# RUN:   2>&1 | FileCheck %s

# With hide-native-frames=true, only Python frames appear.
# CHECK: frame #0: add at ibid_test.py:5{{.*}} [synthetic]
# CHECK: frame #1: compute at ibid_test.py
# CHECK: frame #2: main at ibid_test.py
# CHECK: frame #3: <module> at ibid_test.py

# No lldb_bridge.so or python3 native frames should appear.
# CHECK-NOT: lldb_bridge.so`
# CHECK-NOT: python3`
