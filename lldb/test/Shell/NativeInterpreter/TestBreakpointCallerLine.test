# Tests that a breakpoint inside main() (a non-leaf function) stops correctly
# and shows the right frame with the correct backtrace.

# REQUIRES: python
# UNSUPPORTED: system-windows

# RUN: env PYTHONPATH=%ibid_lib_dir %lldb -b \
# RUN:   -o "settings set target.enable-native-interpreter true" \
# RUN:   -o "file %python" \
# RUN:   -o "settings set target.run-args %S/Inputs/ibid_test.py" \
# RUN:   -o "breakpoint set --file ibid_test.py --line 13" \
# RUN:   -o "run" \
# RUN:   -o "bt" \
# RUN:   -o "quit" \
# RUN:   2>&1 | FileCheck %s

# CHECK: stop reason = breakpoint
# CHECK: frame #0: main at ibid_test.py:13{{.*}} [synthetic]
# CHECK: frame #1: <module> at ibid_test.py:20{{.*}} [synthetic]
