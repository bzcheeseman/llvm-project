# Tests that a breakpoint at a leaf function fires 4 times in total:
# add is called twice per compute() call, and compute() is called twice.

# REQUIRES: python
# UNSUPPORTED: system-windows

# RUN: env PYTHONPATH=%ibid_lib_dir %lldb -b \
# RUN:   -o "settings set target.enable-native-interpreter true" \
# RUN:   -o "file %python" \
# RUN:   -o "settings set target.run-args %S/Inputs/ibid_test.py" \
# RUN:   -o "breakpoint set --file ibid_test.py --line 5" \
# RUN:   -o "run" \
# RUN:   -o "continue" \
# RUN:   -o "continue" \
# RUN:   -o "continue" \
# RUN:   -o "quit" \
# RUN:   2>&1 | FileCheck %s

# CHECK-COUNT-4: stop reason = breakpoint
