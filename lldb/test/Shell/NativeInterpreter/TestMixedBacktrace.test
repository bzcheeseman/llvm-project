# Tests that a full backtrace shows synthetic interpreter frames at the top
# followed by OS/runtime frames. All interpreter-engine frames — bridge glue
# (__ibid_breakpoint_hit, ProgramState_call) and Python internals matching
# __ibid_function_elision_regex — are hidden; only frames above the interpreter
# (libc, _start, etc.) appear.

# REQUIRES: python
# UNSUPPORTED: system-windows

# RUN: env PYTHONPATH=%ibid_lib_dir %lldb -b \
# RUN:   -o "settings set target.enable-native-interpreter true" \
# RUN:   -o "file %python" \
# RUN:   -o "settings set target.run-args %S/Inputs/ibid_test.py" \
# RUN:   -o "breakpoint set --file ibid_test.py --line 5" \
# RUN:   -o "run" \
# RUN:   -o "bt" \
# RUN:   -o "quit" \
# RUN:   2>&1 | FileCheck %s

# Synthetic interpreter frames start at frame #0.
# CHECK: frame #0: add at ibid_test.py:5{{.*}} [synthetic]
# CHECK: frame #1: compute at ibid_test.py
# CHECK: frame #2: main at ibid_test.py
# CHECK: frame #3: <module> at ibid_test.py

# After the synthetic frames, only OS/runtime frames remain.
# CHECK: {{python3|dyld}}{{.*}}`

# Bridge and Python-internal frames must not appear.
# CHECK-NOT: lldb_bridge.so`
# CHECK-NOT: `trace_trampoline
# CHECK-NOT: `_PyEval_EvalFrameDefault
