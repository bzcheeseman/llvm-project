# Tests that a full backtrace shows synthetic interpreter frames at the top
# followed by the native C frames from the interpreter below them.

# REQUIRES: python
# UNSUPPORTED: system-windows

# RUN: env PYTHONPATH=%ibid_lib_dir %lldb -b \
# RUN:   -o "settings set target.enable-native-interpreter true" \
# RUN:   -o "file %python" \
# RUN:   -o "settings set target.run-args %S/Inputs/ibid_test.py" \
# RUN:   -o "breakpoint set --file ibid_test.py --line 5" \
# RUN:   -o "run" \
# RUN:   -o "bt" \
# RUN:   -o "quit" \
# RUN:   2>&1 | FileCheck %s

# Synthetic interpreter frames start at frame #0.
# CHECK: frame #0: add at ibid_test.py:5{{.*}} [synthetic]

# Native C frames appear after the synthetic ones. The topmost C frame is
# the IBID breakpoint anchor (__ibid_breakpoint_hit for a source-line BP,
# __ibid_debugger_anchor for the slow-path anchor), followed by
# ProgramState_call which drives the trace.
# CHECK: lldb_bridge.so`
# CHECK: lldb_bridge.so`ProgramState_call
