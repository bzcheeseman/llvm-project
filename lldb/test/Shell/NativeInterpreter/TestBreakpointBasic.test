# Tests that a breakpoint at a line inside a leaf function stops the process
# at the correct location and shows the function and line in the announcement.

# REQUIRES: python
# UNSUPPORTED: system-windows

# RUN: env PYTHONPATH=%ibid_lib_dir %lldb -b \
# RUN:   -o "settings set target.enable-native-interpreter true" \
# RUN:   -o "file %python" \
# RUN:   -o "settings set target.run-args %S/Inputs/ibid_test.py" \
# RUN:   -o "breakpoint set --file ibid_test.py --line 5" \
# RUN:   -o "run" \
# RUN:   -o "quit" \
# RUN:   2>&1 | FileCheck %s

# The stop announcement should show frame 0 as add:5.
# CHECK: stop reason = breakpoint
# CHECK: frame #0: add at ibid_test.py:5{{.*}} [synthetic]
