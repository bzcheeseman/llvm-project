import sys

sys.path.append("@CMAKE_LIBRARY_OUTPUT_DIRECTORY@")

import lldb_bridge


def wrapper_main(filename: str):
    with open(filename) as f:
        code = f.read()

    tracer = lldb_bridge.ProgramState()
    code_obj = compile(code, filename, "exec")

    # Set the global trace function before exec so the new frame is traced
    # from its very first line, with no line-number offset.
    sys.settrace(tracer)
    exec(code_obj, {"__name__": "__main__"})
    sys.settrace(None)


if __name__ == "__main__":
    wrapper_main(sys.argv[1])
